{
  "name": "nemo-live-kora",
  "version": "1.0.0",
  "private": true,
  "description": "بوابة مباريات NEMO Sports المستقلة — جدول المباريات بتوقيت القاهرة مع روابط الصفحات المطابقة التي تم التحقق منها فقط",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "test": "NEMO_GATEWAY_STORE_PERSIST=off node --import tsx --test tests/*.test.ts",
    "sync": "node --import tsx scripts/run-sync.ts",
    "coverage:compare": "node --import tsx scripts/coverage-compare.ts",
    "store:check": "node --import tsx scripts/check-store.ts",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "audit:duplicates": "node --import tsx scripts/audit-fixture-duplicates.ts",
    "audit:all": "npm audit --audit-level=low",
    "security": "npm run audit:prod && node --import tsx scripts/security-check.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit:prod",
    "admin:password": "node --import tsx scripts/admin-password.ts",
    "audit:connectivity": "node --import tsx scripts/audit-connectivity.ts",
    "audit:analytics": "node --import tsx scripts/audit-analytics.ts",
    "audit:score-pairing": "node --import tsx scripts/audit-score-pairing.ts",
    "audit:adsense": "node --import tsx scripts/audit-adsense.ts"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "fast-glob": "3.3.1"
  }
}

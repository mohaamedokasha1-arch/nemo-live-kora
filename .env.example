# ==============================================================================
# NEMO Sports Match Gateway (nemo-live-kora) — Environment Variables Example
# ==============================================================================
# تنبيه أمني: لا تضع مفاتيح سرية حقيقية في هذا الملف داخل Git.
# ضع القيم الحقيقية في .env.local محليًا أو في Vercel Environment Variables.
# كل متغير هنا يُقرأ عبر lib/config/env.ts الذي يزيل المسافات وعلامات الاقتباس المحيطة
# ويعتبر القيم الوهمية (your_api_key، changeme، xxx…) كأنها غير مضبوطة.

# ------------------------------------------------------------------------------
# 1) التخزين — لا يحتاج أي إعداد
# ------------------------------------------------------------------------------
# البيانات تُحفظ في ملف JSON محلي مهيكل تُكتب عبر استبدال ذرّي (temporary + fsync + rename):
#   - على خادم عادي: data/gateway-store.json (يبقى بعد إعادة التشغيل).
#   - على Vercel/Lambda: /tmp/nemo-gateway/gateway-store.json (ذاكرة للنسخة الدافئة فقط).
# لا توجد قاعدة بيانات خارجية ولا متغيرات سحابية مطلوبة. الاختياري فقط:
# NEMO_DATA_DIR=/var/lib/nemo-gateway/data     # لتغيير مجلد الملف
# NEMO_GATEWAY_STORE_PERSIST=off               # تعطيل الكتابة (للاختبارات فقط)

# ------------------------------------------------------------------------------
# 2) روابط الموقع
# ------------------------------------------------------------------------------
# رابط موقع NEMO Sports الرئيسي الذي توجه إليه البوابة الزوار
NEXT_PUBLIC_NEMO_SPORTS_URL=https://nemo-sports.vercel.app
# رابط موقع البوابة المنشور (Canonical و Sitemap و OpenGraph)
GATEWAY_SITE_URL=https://nemo-live-kora.vercel.app
# المنطقة الزمنية الافتراضية لعرض وتصنيف المباريات
DEFAULT_TIMEZONE=Africa/Cairo

# ------------------------------------------------------------------------------
# 3) المصادر الخمسة المعتمدة (5 Approved Sources)
# ------------------------------------------------------------------------------

# 1) SportScore — API عام مجاني بدون مفتاح (https://sportscore.com/developers/)
#    القيمة هي أصل الموقع وليس مسار /api/widget؛ تُبنى نقاط النهاية تلقائيًا:
#      /api/widget/matches/  ·  /api/v1/matches/  ·  /api/v1/fixtures/?date=  ·  /api/widget/standings/
SPORTSCORE_BASE_URL=https://sportscore.com
# معرّف اختياري يُرسل كـ ?src= للتعريف بالنفس (موصى به)
SPORTSCORE_SRC=nemo-live-kora
# مفتاح اختياري إن كان لديك حساب
SPORTSCORE_API_KEY=

# 2) Football-Data.org v4
#    /v4/competitions يعمل بدون مفتاح؛ /v4/matches و /v4/competitions/{code}/standings تحتاج مفتاحًا مجانيًا
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_KEY=

# 3) TheSportsDB v1 JSON API
#    المفتاح المجاني العام الموثّق هو 123 (والمفتاح التاريخي 3 ما زال يعمل).
#    إن ضُبط مفتاح مدفوع مرفوض من المزوّد يتم الرجوع تلقائيًا إلى 123 ثم 3 بدل تعطيل الجدول.
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
THESPORTSDB_V2_BASE_URL=https://www.thesportsdb.com/api/v2/json
THESPORTSDB_API_KEY=123
# معرّفات البطولات المتابعة (اتركها كما هي إلا إذا تغيّرت لدى المزوّد)
THESPORTSDB_EGY_LEAGUE_ID=4829
THESPORTSDB_EGY_LEAGUE_CUP_ID=5185
THESPORTSDB_CAF_CONFED_ID=5057
# معرّفات مستبعدة لأن fixtures الخاصة بها ليست كرة قدم
THESPORTSDB_EXCLUDED_LEAGUE_IDS=4830

# 4) API-Football v3 (api-sports.io)
#    النقل المباشر: x-apisports-key على https://v3.football.api-sports.io
#    النقل عبر RapidAPI: اضبط API_FOOTBALL_HOST فيُرسل x-rapidapi-key + x-rapidapi-host
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=
# API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com
# معرّفات البطولات المستخدمة في جلب جدول كامل + الترتيب
API_FOOTBALL_EGYPT_LEAGUE_ID=302
API_FOOTBALL_EGYPT_CUP_ID=303
API_FOOTBALL_CAF_CL_ID=272
API_FOOTBALL_CAF_CONFED_ID=273

# 5) Google News RSS — مجاني بدون مفتاح
#    روابط الخلاصة وسيطة (news.google.com/rss/articles/…) ويُفكّ تشفيرها عبر:
#    فك base64/protobuf محلي ← استدعاء Fbv4je ← سلسلة تحويلات HTTP ← صفحة HTML الوسيطة.
GOOGLE_NEWS_RSS_BASE_URL=https://news.google.com/rss
# قراءة صفحة الناشر لاستخراج ملخصه الحقيقي (og:description) بدل تكرار العنوان
NEMO_NEWS_ENRICH=on

# ------------------------------------------------------------------------------
# 4) حماية بعض نقاط التحديث اليدوي أو المجدول (Background Sync Security)
# ------------------------------------------------------------------------------
# نافذة التواريخ للمزامنة المجدولة (cron/sync) — قابلة للضبط بلا تعديل الكود:
#   NEMO_SYNC_DAYS_BACK   عدد الأيام السابقة لاستكمال النتائج (الافتراضي 1، الحد الأقصى 30)
#   NEMO_SYNC_DAYS_AHEAD  عدد الأيام القادمة (الافتراضي 7، الحد الأقصى 14)
# ما يُطلب من كل مصدر يُسجَّل في سجل المزامنة (dateWindow) مع الأيام التي تُخطّيت بسبب الميزانية الزمنية.
# التحديث عند الطلب يبقى الأمس/اليوم/غدًا بغض النظر عن هذين المتغيرين.
# NEMO_SYNC_DAYS_BACK=1
# NEMO_SYNC_DAYS_AHEAD=7

# مرجع تغطية المباريات (اختياري، للقراءة فقط عبر: npm run coverage:compare)
# Football-Data.org API الرسمي يستخدم FOOTBALL_DATA_API_KEY الموجود أعلاه.
# كووورة غير مسموح بها كمرجع آلي (شروط الاستخدام تمنع الكشط). استخدم ملف تصدير مرخص:
#   npm run coverage:compare -- --reference=file:./exports/reference.json

# CRON_SECRET / NEMO_INGEST_TOKEN يحميان /api/cron/sync و/api/cron/sync-news ولوحة الإدارة.
# أرسل Authorization: Bearer <CRON_SECRET> لتلك المسارات.
#
# ملاحظة جدولة (vercel.json): وظيفتان يوميتان — المهمة المجانية تسمح بمهمتين لكلٍّ موعد واحد:
#   • 05:00 UTC  →  /api/cron/sync            مزامنة كاملة: كل مصادر المباريات + كل مجموعات الأخبار
#                                              (تحتاج CRON_SECRET؛ Vercel يرسلها تلقائيًا عند ضبطه)
#   • 16:00 UTC  →  /api/cron/update-matches  تحديث النتائج والمواعيد مساءً (لا يحتاج أي سر)
# وبالإضافة إلى ذلك يتجدّد المحتوى **عند الطلب** مع كل زيارة (نافذة 10 دقائق للمباريات و15
# دقيقة للأخبار، مع تدوير مجموعات الخلاصات)، فلا يتوقف التحديث إذا تأخرت المهمة المجدولة.
#
# /api/cron/update-matches لا يتطلب مصادقة؛ أي طلب GET/POST يشغّل محاولة مزامنة.
# احذر أن تكرار الطلبات إلى المسار العام قد يستهلك موارد الخادم وحصص المزودين.
#
# المسار يُرجع دائمًا HTTP 200 مع ok:true؛ الحالة الفعلية في status و syncOk و durable و warnings.
# لتوليد قيمة قوية:
#   openssl rand -hex 32
CRON_SECRET=
NEMO_INGEST_TOKEN=

# ------------------------------------------------------------------------------
# أدوات الفحص (lib/storage/) — اختياري
# ------------------------------------------------------------------------------
# npm run store:check        # قراءة فقط: يعرض مكان الملف وهل يمكن قراءته
# node --import tsx scripts/storage-migrate.ts --from=path/to/gateway-store.json

# ------------------------------------------------------------------------------
# محرّك المباريات التلقائي + SEO + الإعلانات (Automated Match Engine & Ads)
# ------------------------------------------------------------------------------
# ملف المباريات المركزي: data/matches.ts
# كل مباراة تُضاف هناك ينتج عنها تلقائيًا: صفحة هبوط /matches/[id] + صفحة بث /live/[id]
# + بيانات SportsEvent منظمة كاملة + رابط في /sitemap.xml مع توقيت التحديث.

# ------------------------------------------------------------------------------
# نظام التوجيه الديناميكي الموحّد للمشاهدة (Unified Watch Routing)
# ------------------------------------------------------------------------------
# مصدر واحد لكل روابط المشاهدة الخارجية في الموقع: lib/nemo-watch.ts
# كل زر «🔴 اضغط هنا لمشاهدة البث المباشر للمباراة» — في كل صفحة مباراة، لكل مباراة
# حالية أو قادمة أو منتهية — يفتح صفحة المشاهدة هذه، **ويختار الزائر المباراة بنفسه
# من الصفحة**. لذلك العنوان صافٍ بلا معرّف ولا معامل استعلام.
# غيّر هذا المتغير وحده لتغيير وجهة المشاهدة في الموقع كله بلا أي تعديل في الكود.
NEXT_PUBLIC_NEMO_WATCH_BASE_URL=https://nemo-sports.vercel.app/watch

# نمط التوجيه (اختياري — الافتراضي هو المطلوب، ولا حاجة لضبطه):
#   gateway      (الافتراضي) — صفحة المشاهدة الصافية، والزائر يختار المباراة بنفسه.
#   id-param     — إرفاق معرّف المباراة كمعامل استعلام (?id=...) لمن يريد تجربته.
#   exact-first  — تُقدَّم صفحة المباراة المطابقة المُتحقَّق منها أولًا حيث توجد، ثم البوابة.
# NEXT_PUBLIC_NEMO_WATCH_MODE=gateway

# رقم الوحدة الإعلانية الافتراضية لـ AdSense (اختياري)
# NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
# وحدتا الإعلان المحيطتان بزر المشاهدة (فوق الزر وتحته) — اختياريتان ومستقلتان
# NEXT_PUBLIC_ADSENSE_SLOT_ABOVE_WATCH=
# NEXT_PUBLIC_ADSENSE_SLOT_BELOW_WATCH=
# معرّف ناشر AdSense (عند ضبطه: يُحمَّل السكربت + يُبنى /ads.txt + تظهر المساحات)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1234567890123456
# أسطر إضافية في /ads.txt (مفصولة بـ ; أو سطر جديد)
# ADS_TXT_LINES="example.com, 12345, DIRECT, a1b2c3d4e5f6a7b8"
# بريد التواصل المعروض في /contact
# NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# تنبيه: لا تستخدم EventLive في eventStatus داخل البيانات المنظمة —
# القيم المعتمدة في Schema.org هي: EventScheduled, EventCancelled, EventMovedOnline,
# EventPostponed, EventRescheduled. المباراة الجارية تُخرج EventScheduled تلقائيًا.

# ==============================================================================
# 6) لوحة الإدارة (Admin Console) — الحماية والتخزين الدائم لتعديلات المدير
# ==============================================================================
# ⚠️ لا توجد أي بيانات دخول افتراضية في الكود. بلا هذه المتغيّرات تُعرض اللوحة برسالة
#    «غير مهيّأة» ولا تُنشأ أي جلسة (لا يمكن الدخول إطلاقًا).
#
# (أ) الحساب: ولّد الـ hash محليًا (كلمة المرور نفسها لا تُخزَّن ولا تُرسل لأي مكان):
#       npm run admin:password -- "كلمة-مرور-قوية-طويلة"
NEMO_ADMIN_USER=admin
NEMO_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...ضع-الناتج-هنا...
# دور الحساب: owner (كل شيء) | editor (لا يستعيد النسخ ولا يغيّر الإعدادات) | viewer (قراءة فقط)
NEMO_ADMIN_ROLE=owner
# مفتاح توقيع جلسة الإدارة (≥32 حرفًا عشوائيًا) — بلا هذا المفتاح لا تُنشأ جلسات:
#   openssl rand -hex 32
NEMO_ADMIN_SESSION_SECRET=
# حسابات متعددة بأدوار مختلفة (بديل عن الحساب الواحد). JSON بمصفوفة:
# NEMO_ADMIN_USERS=[{"username":"admin","role":"owner","displayNameAr":"مدير الموقع","passwordHash":"scrypt$..."},{"username":"editor","role":"editor","displayNameAr":"محرّر","passwordHash":"scrypt$..."}]

# (ب) التخزين الدائم لتعديلات المدير (إضافة/تعديل المباريات، الأخبار، الإعدادات، النسخ)
# على Vercel لا يوجد قرص دائم: بلا هذا الإعداد تعمل التعديلات للعرض الفوري داخل النسخة
# الدافئة فقط، ولا تبقى بعد إعادة التشغيل ولا تُرى من النسخ الأخرى. والنسخ الاحتياطية
# تُرفض صريحًا (لا نجاح وهمي) حتى يُضبط تخزين دائم.
#
# الخيار الوحيد الدائم المشترك حاليًا: مستودع GitHub (يُستخدم واجهة Contents API).
#   • GITHUB_TOKEN: رمز بصلاحية الكتابة على المستودع (Fine-grained: Contents = Read and write).
#   • GITHUB_REPO: owner/repo (مثال: mohaamedokasha1-arch/nemo-live-kora).
#   • GITHUB_BRANCH: الفرع (الافتراضي main).
#   ملاحظة صريحة: الحفظ عبر الإيداع يظهر في الموقع بعد إعادة النشر (Vercel يعيد النشر
#   تلقائيًا عند كل إيداع). لكن قراءة المستند تتم من التخزين في كل طلب، فتظهر التعديلات
#   في الموقع فورًا داخل النسخة التي نفّذت الحفظ. (التوليد التلقائي عند أي زيارة يعيد
#   بناء الصفحات من نفس المصدر.)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
# خيار صريح لفرض استخدام الملف المحلي بدل GitHub (للتطوير المحلي أو خادم بقرص دائم):
# NEMO_MANUAL_DRIVER=file
# مسار مخصّص لملف المستند (اختياري، الافتراضي data/manual-content.json أو NEMO_DATA_DIR):
# NEMO_MANUAL_FILE_PATH=
# اجعل القرص المحلي معتبرًا «دائمًا» (خادم بقرص دائم أو قرص مثبَّت):
# NEMO_MANUAL_FILE_DURABLE=true
# تعطيل الكتابة من اللوحة كليًا (قراءة فقط):
# NEMO_MANUAL_WRITE=off

# (ج) النسخ الاحتياطية
# عدد النسخ المحفوظة (الأقدم يُحذف تلقائيًا بعد كل نسخة ناجحة). الافتراضي 7 والحد الأقصى 50:
NEMO_BACKUP_RETENTION=7
# مجلد النسخ داخل المستودع عند استخدام تخزين GitHub (الافتراضي data/backups):
# NEMO_BACKUP_DIR=data/backups

# (د) مستخدم مصدر مباريات إضافي (اختياري): عند ضبط مفتاح API-Football يعمل المصدر
#     تلقائيًا ويظهر في اللوحة بحالته الحقيقية. بلا مفتاح يظهر «يتطلب مفتاحًا» بصدق.
# API_FOOTBALL_KEY= الموجود أعلى الملف

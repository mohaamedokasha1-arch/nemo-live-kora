# ==============================================================================
# NEMO Sports Match Gateway (nemo-live-kora) — Environment Variables Example
# ==============================================================================
# تنبيه أمني: لا تضع مفاتيح سرية حقيقية في هذا الملف داخل Git.
# ضع القيم الحقيقية في .env.local محليًا أو في Vercel Environment Variables.

# رابط موقع NEMO Sports الرئيسي الذي توجه إليه البوابة الزوار
NEXT_PUBLIC_NEMO_SPORTS_URL=https://nemo-sports.vercel.app

# رابط موقع البوابة المنشور (Canonical و Sitemap و OpenGraph)
GATEWAY_SITE_URL=https://nemo-live-kora-matchat.vercel.app
# عند عدم ضبطه، يستخدم التطبيق VERCEL_PROJECT_PRODUCTION_URL ثم هذا المتغير القديم للتوافق فقط.
# NEXT_PUBLIC_GATEWAY_URL=https://nemo-live-kora-matchat.vercel.app

# المنطقة الزمنية الافتراضية لعرض وتصنيف المباريات
DEFAULT_TIMEZONE=Africa/Cairo

# ------------------------------------------------------------------------------
# المصادر الخمسة المعتمدة (5 Approved Sources)
# ------------------------------------------------------------------------------

# 1) SportScore Widget API (مجاني بدون مفتاح)
SPORTSCORE_BASE_URL=https://sportscore.com/api/widget

# 2) Football-Data.org v4 API
# يعمل مسار /v4/competitions بدون مفتاح، بينما مسارات /v4/matches و /v4/competitions/{code}/standings تتطلب مفتاحًا مجانيًا:
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_KEY=

# 3) TheSportsDB v1 JSON API (المفتاح العام المجاني هو 3)
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
THESPORTSDB_API_KEY=3

# 4) API-Football v3 (api-sports.io)
# يتطلب مفتاحًا من لوحة api-sports.io لتفعيل الجلب المباشر للمباريات والنتائج الحية:
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=

# 5) Google News RSS (مجاني بدون مفتاح)
GOOGLE_NEWS_RSS_BASE_URL=https://news.google.com/rss/search

# ------------------------------------------------------------------------------
# حماية نقاط التحديث اليدوي أو المجدول خارجيًا (Background Sync Security)
# ------------------------------------------------------------------------------
# مطلوب لمسار /api/cron/update-matches: أي طلب بدون الترويسة
# Authorization: Bearer <CRON_SECRET> يرجّع 401 Unauthorized.
# أرسل هذه الترويسة بنفسك عند الاستدعاء اليدوي أو اضبطها في المجدول الخارجي.
# جدولة Vercel: مهمة واحدة يوميًا (خطة Hobby) تستدعي /api/cron/update-matches
# وتُرسل تلقائيًا ترويسة Authorization: Bearer $CRON_SECRET عند ضبط المتغير.
# عدم ضبط CRON_SECRET على الخادم يرجّع 500 (خطأ إعدادات) ولا يفتح المسار للعامة.
# NEMO_INGEST_TOKEN اختياري لحماية لوحة /admin/news ومسار /api/cron/sync.
# لتوليد قيمة قوية:
#   openssl rand -hex 32
CRON_SECRET=
NEMO_INGEST_TOKEN=
